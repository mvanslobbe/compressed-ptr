# clang-tidy configuration. CI runs it through scripts/run_tidy.sh, which
# checks every test and example but gates only on diagnostics in
# include/cptr: tests deliberately use moved-from objects, fixed seeds and
# the like.
#
# Disabled checks, and why:
# - performance-no-int-to-ptr: turning an offset back into a pointer is
#   what a compressed pointer does.
# - bugprone-implicit-widening-of-multiplication-result: fires on constant
#   sizes such as 64 * 1024, which cannot overflow.
# - bugprone-std-namespace-modification: fires on the std::hash
#   specialisations, which the standard allows.
# - bugprone-crtp-constructor-accessibility: cages are tag types meant to be
#   derived from with `struct my_heap : cptr::cage<my_heap> {};`.
# - bugprone-casting-through-void: fires inside the CPTR_POISON macro when
#   AddressSanitizer is off.
# - bugprone-sizeof-expression, bugprone-multi-level-implicit-pointer-conversion:
#   fire on allocator<T*>, where T is itself a pointer (clang-tidy 18).
# - bugprone-easily-swappable-parameters, bugprone-reserved-identifier,
#   bugprone-macro-parentheses, bugprone-exception-escape: style, or noise
#   from the platform headers.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-macro-parentheses,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-std-namespace-modification,
  -bugprone-crtp-constructor-accessibility,
  -bugprone-casting-through-void,
  -bugprone-sizeof-expression,
  -bugprone-multi-level-implicit-pointer-conversion,
  clang-analyzer-*,
  -clang-analyzer-optin.*,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  misc-redundant-expression,
  misc-misplaced-const,
  misc-unconventional-assign-operator,
  modernize-use-nullptr,
  modernize-use-override
HeaderFilterRegex: '.*/include/cptr/.*'
